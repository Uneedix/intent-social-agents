{
  "name": "intent-social",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "test": "tsx --tsconfig tsconfig.test.json --experimental-test-module-mocks --test tests/*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db && npm run security:secrets",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.28",
    "react-test-renderer": "19.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  }
}
